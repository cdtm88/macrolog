// Copy this file to `Secrets.xcconfig` (same folder) and paste your keys.
// `Secrets.xcconfig` is gitignored, so no credential ever enters version
// control (PRD SEC-01 / decision D-05, bridge spec HB-07 / MAC-04).
//
//   cp MacroLog/Config/Secrets.example.xcconfig MacroLog/Config/Secrets.xcconfig
//
// Set your Anthropic API key below (no quotes):

ANTHROPIC_API_KEY =

// intervals.icu body-mass bridge (bridge spec P07). Leave both blank to
// disable weight sync entirely — the app then never asks for Health read
// access and never contacts intervals.icu.

INTERVALS_ATHLETE_ID =
INTERVALS_API_KEY =

// Coach macro relay (bridge spec P06). Leave blank to disable.
// NOTE: xcconfig treats "//" as a comment, so write the URL with an empty
// variable splice:  COACH_BASE_URL = https:/$()/coach.example.com

COACH_BASE_URL =
COACH_INGEST_SECRET =
